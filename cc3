STEP 8: Apex Controller Code
Paste this code:
public class MovieController {

    public Movie__c mv {get; set;}

    public List<Movie__c> movieList {get; set;}

    public Boolean isEdit {get; set;}

    public MovieController() {

        mv = new Movie__c();

        isEdit = false;

        getMovies();
    }

    // LOAD MOVIES
    public void getMovies() {

        movieList = [
            SELECT Id,
                   Name,
                   Movie_ID__c,
                   Director_Name__c,
                   Rating__c
            FROM Movie__c
        ];
    }

    // CREATE
    public PageReference saveMovie() {

        insert mv;

        mv = new Movie__c();

        getMovies();

        return null;
    }

    // DELETE
    public PageReference deleteMovie() {

        String movieId =
            ApexPages.currentPage()
                     .getParameters()
                     .get('mid');

        delete [
            SELECT Id
            FROM Movie__c
            WHERE Id = :movieId
        ];

        getMovies();

        return null;
    }

    // EDIT
    public PageReference editMovie() {

        String movieId =
            ApexPages.currentPage()
                     .getParameters()
                     .get('eid');

        mv = [
            SELECT Id,
                   Name,
                   Movie_ID__c,
                   Director_Name__c,
                   Rating__c
            FROM Movie__c
            WHERE Id = :movieId
        ];

        isEdit = true;

        return null;
    }

    // UPDATE
    public PageReference updateMovie() {

        update mv;

        mv = new Movie__c();

        isEdit = false;

        getMovies();

        return null;
    }
}
