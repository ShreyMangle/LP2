STEP 10: Visualforce GUI Code
Paste this code:
<apex:page controller="MovieController">

    <apex:form>

        <apex:pageBlock title="Movie Management System">

            <apex:pageBlockSection columns="1">

                <apex:outputLabel value="Movie Name"/>

                <apex:inputText value="{!mv.Name}" />

                <apex:outputLabel value="Movie ID"/>

                <apex:inputText value="{!mv.Movie_ID__c}" />

                <apex:outputLabel value="Director Name"/>

                <apex:inputText value="{!mv.Director_Name__c}" />

                <apex:outputLabel value="Rating"/>

                <apex:inputText value="{!mv.Rating__c}" />

            </apex:pageBlockSection>

            <!-- SAVE -->

            <apex:commandButton
                value="Save Movie"
                action="{!saveMovie}"
                rendered="{!NOT(isEdit)}"
                rerender="tbl"/>

            <!-- UPDATE -->

            <apex:commandButton
                value="Update Movie"
                action="{!updateMovie}"
                rendered="{!isEdit}"
                rerender="tbl"/>

        </apex:pageBlock>

        <!-- TABLE -->

        <apex:pageBlock title="Movie Records">

            <apex:pageBlockTable
                value="{!movieList}"
                var="m"
                id="tbl">

                <apex:column value="{!m.Name}"
                             headerValue="Movie Name"/>

                <apex:column value="{!m.Movie_ID__c}"
                             headerValue="Movie ID"/>

                <apex:column value="{!m.Director_Name__c}"
                             headerValue="Director"/>

                <apex:column value="{!m.Rating__c}"
                             headerValue="Rating"/>

                <!-- EDIT -->

                <apex:column headerValue="Edit">

                    <apex:commandLink
                        value="Edit"
                        action="{!editMovie}">

                        <apex:param
                            name="eid"
                            value="{!m.Id}" />

                    </apex:commandLink>

                </apex:column>

                <!-- DELETE -->

                <apex:column headerValue="Delete">

                    <apex:commandLink
                        value="Delete"
                        action="{!deleteMovie}">

                        <apex:param
                            name="mid"
                            value="{!m.Id}" />

                    </apex:commandLink>

                </apex:column>

            </apex:pageBlockTable>

        </apex:pageBlock>

    </apex:form>

</apex:page>
